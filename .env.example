# Copier en .env (ou dans la configuration de lancement de l'IDE) et renseigner les valeurs.
# Ne jamais committer de vraies valeurs.

# --- Base de données ---
DB_URL=jdbc:sqlserver://localhost:1433;database=usermanagementdb;encrypt=true;trustServerCertificate=true
# DB_URL=jdbc:postgresql://localhost:5432/usermanagementdb
# DB_URL=jdbc:mysql://localhost:3306/usermanagementdb
DB_USERNAME=sa
DB_PASSWORD=

# update (dev) | validate (prod, avec Flyway/Liquibase) | create-drop (tests)
JPA_DDL_AUTO=update

# --- JWT ---
# Clé Base64 d'au moins 32 octets : openssl rand -base64 64
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# --- Premier administrateur (créé seulement s'il n'existe aucun admin actif) ---
IAM_ADMIN_EMAIL=admin@gmail.com
# Vide => mot de passe aléatoire affiché une seule fois dans les logs
IAM_ADMIN_PASSWORD=

# --- Inscription libre (POST /api/auth/register) ---
IAM_REGISTRATION_ENABLED=false

# --- CORS (listes séparées par des virgules) ---
CORS_ALLOWED_ORIGINS=http://localhost:4200
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true

PORT=9001
